{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd frontend && npm ci",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "framework": null,
  "rewrites": [
    { "source": "/irsa/:path*", "destination": "https://irsa.ipac.caltech.edu/:path*" },
    { "source": "/simbad/:path*", "destination": "https://simbad.cds.unistra.fr/:path*" }
  ]
}
